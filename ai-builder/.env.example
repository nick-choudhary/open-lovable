# ============================================================================
# AI Provider Configuration
# ============================================================================

# Choose your AI provider
# Options: openai-compatible, anthropic, openai, google
AI_PROVIDER=openai-compatible

# AI Model name (depends on your provider)
# OpenAI: gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20241022
# Local (LM Studio): llama-3-70b, mixtral-8x7b, etc.
# Together AI: meta-llama/Llama-3-70b-chat-hf
# Groq: llama-3.1-70b-versatile
AI_MODEL=gpt-4

# ============================================================================
# OpenAI-Compatible Endpoint (for ANY provider using OpenAI spec)
# ============================================================================

# Custom base URL - Examples:
#   LM Studio:    http://localhost:1234/v1
#   Ollama:       http://localhost:11434/v1
#   Together AI:  https://api.together.xyz/v1
#   Groq:         https://api.groq.com/openai/v1
#   Perplexity:   https://api.perplexity.ai
#   OpenAI:       https://api.openai.com/v1 (default)
OPENAI_BASE_URL=http://localhost:1234/v1

# API Key (use 'local' for local models like LM Studio or Ollama)
OPENAI_API_KEY=local

# ============================================================================
# Alternative Providers (if not using openai-compatible)
# ============================================================================

# Anthropic (Best for prompt caching - 90% cost savings)
# ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Google AI
# GEMINI_API_KEY=xxx

# ============================================================================
# Advanced AI Settings (Optional)
# ============================================================================

# Temperature (0.0 = focused, 1.0 = creative)
AI_TEMPERATURE=0.7

# Max tokens per request
AI_MAX_TOKENS=8192

# ============================================================================
# Sandbox Configuration (Optional)
# ============================================================================

# Where to store generated projects
PROJECTS_DIR=./projects

# ============================================================================
# Advanced Settings (Optional)
# ============================================================================

# Enable verbose logging
NODE_ENV=development  # or production

# Next.js URL (for internal API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000
