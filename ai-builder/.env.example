# ============================================================================
# AI Provider Configuration
# ============================================================================

# Choose your AI provider (anthropic recommended for prompt caching)
AI_PROVIDER=anthropic  # Options: anthropic, openai, google

# AI Model to use
AI_MODEL=claude-3-5-sonnet-20241022  # or gpt-4, gemini-pro, etc.

# ============================================================================
# API Keys (Add at least one)
# ============================================================================

# Anthropic (Recommended for 90% cost savings with prompt caching)
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# OpenAI
OPENAI_API_KEY=sk-xxx

# Google AI
GEMINI_API_KEY=xxx

# ============================================================================
# Sandbox Configuration (Optional)
# ============================================================================

# Where to store generated projects
PROJECTS_DIR=./projects

# ============================================================================
# Advanced Settings (Optional)
# ============================================================================

# Enable verbose logging
NODE_ENV=development  # or production

# Next.js URL (for internal API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000
